# Rust / Cargo
# No trailing slash: a linked worktree's `target` is often a symlink into a shared
# build cache (the layout scripts/test_reap_test_servers.sh exercises), and `target/`
# matches directories only, so the symlink showed up as untracked. The unanchored
# pattern also matches a file named `target`; no tracked path is named `target`
# (`git ls-files | grep -E '(^|/)target$'` is empty) and protocol/tests/
# test_pre_push_checks.py keeps it that way.
target
**/*.rs.bk

# Swift / SwiftPM / Xcode
.build/
.swiftpm/
.cache/
Packages/
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/

# macOS / OS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# IDE / Editors
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/

# Tooling
.lemoncrow/
.benchmark-results/
scripts/test-swarm/.env
scripts/test-swarm/logs/*.log
.swift-version
