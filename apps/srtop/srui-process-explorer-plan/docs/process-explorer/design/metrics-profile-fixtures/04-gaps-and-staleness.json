      "ops": [
        {"op": "set_property", "node": 40, "prop": "m:metric_state", "value": {"string": "ok"}},
        {"op": "set_property", "node": 40, "prop": "m:metric_value", "value": {"float": 12.5}}
      ],
      "expect": {
