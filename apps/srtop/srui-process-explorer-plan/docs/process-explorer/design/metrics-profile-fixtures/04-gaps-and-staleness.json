        {"op": "model_update", "model": 119, "index": 5, "items": [{"id": 6, "value": {"list": [{"string": "Receive"}, {"string": "08:00:07"}, {"string": "error 1s"}]}}]},
        {"op": "model_insert", "model": 119, "index": 6, "items": [{"id": 7, "value": {"list": [{"string": "Receive"}, {"string": "08:00:08"}, {"string": "warming up 1s"}]}}, {"id": 8, "value": {"list": [{"string": "Receive"}, {"string": "08:00:09"}, {"string": "2.0 KiB/s"}]}}]}
      ],
      "expect": {
        "capable": "accept",
        "base": "accept"
      }
