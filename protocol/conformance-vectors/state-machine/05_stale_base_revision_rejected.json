{
  "name": "stale_base_revision_rejected",
  "description": "A transaction specifying a base revision that does not match the store's current committed revision is rejected with stale_base_revision (§12.1).",
  "spec_sections": ["§12.1"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Window 1"
          }
        }
      ]
    },
    {
      "base_revision": 1,
      "new_revision": 2,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Button",
          "parent_id": 1,
          "child_index": null,
          "properties": {
            "label": "Button 1"
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "CREATE_NODE",
        "node_id": 3,
        "node_type": "Text",
        "parent_id": 1,
        "child_index": null,
        "properties": {
          "text": "Stale Attempt"
        }
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "stale_base_revision",
    "expected_store_revision": 2,
    "rollback_verified": true
  }
}
