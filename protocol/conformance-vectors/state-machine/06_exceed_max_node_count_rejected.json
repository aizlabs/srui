{
  "name": "exceed_max_node_count_rejected",
  "description": "Attempting to create more nodes than allowed by the configured max_node_count limit is rejected with max_node_count_exceeded (§26).",
  "spec_sections": ["§26"],
  "initial_limits": {
    "max_node_count": 2
  },
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {}
        }
      ]
    },
    {
      "base_revision": 1,
      "new_revision": 2,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Button",
          "parent_id": 1,
          "child_index": null,
          "properties": {}
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 2,
    "new_revision": 3,
    "operations": [
      {
        "type": "CREATE_NODE",
        "node_id": 3,
        "node_type": "Text",
        "parent_id": 1,
        "child_index": null,
        "properties": {}
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "max_node_count_exceeded",
    "failed_op_index": 0,
    "expected_store_revision": 2,
    "rollback_verified": true
  }
}
