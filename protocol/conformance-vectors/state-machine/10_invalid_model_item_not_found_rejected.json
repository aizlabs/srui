{
  "name": "invalid_model_item_not_found_rejected",
  "description": "Attempting to update a collection model item referencing an unknown item_id is rejected with item_not_found and rolled back (§8, §13).",
  "spec_sections": ["§8", "§12.1", "§13"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_MODEL",
          "model_id": 10,
          "model_type": "List",
          "item_count": 50
        },
        {
          "type": "MODEL_INSERT",
          "model_id": 10,
          "index": 0,
          "items": [
            {
              "item_id": 101,
              "value": "Existing Item",
              "properties": {}
            }
          ]
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "MODEL_UPDATE",
        "model_id": 10,
        "index": null,
        "items": [
          {
            "item_id": 999,
            "value": "Nonexistent Item Update",
            "properties": {}
          }
        ]
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "item_not_found",
    "failed_op_index": 0,
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
