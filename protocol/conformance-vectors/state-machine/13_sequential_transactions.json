{
  "name": "sequential_transactions",
  "description": "Demonstrates sequential monotonic transactions advancing the semantic tree across revisions 0 -> 1 -> 2 -> 3 with property mutations, insertions, and reordering (§12.1, §13).",
  "spec_sections": ["§12.1", "§13"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Sequential Demo"
          }
        },
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Column",
          "parent_id": 1,
          "child_index": null,
          "properties": {}
        }
      ]
    },
    {
      "base_revision": 1,
      "new_revision": 2,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 3,
          "node_type": "Button",
          "parent_id": 2,
          "child_index": 0,
          "properties": {
            "label": "Submit",
            "enabled": true
          }
        },
        {
          "type": "CREATE_NODE",
          "node_id": 4,
          "node_type": "Text",
          "parent_id": 2,
          "child_index": 1,
          "properties": {
            "text": "Waiting"
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 2,
    "new_revision": 3,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 3,
        "property": "label",
        "value": "Submitted"
      },
      {
        "type": "SET_PROPERTY",
        "node_id": 3,
        "property": "enabled",
        "value": false
      },
      {
        "type": "SET_PROPERTY",
        "node_id": 4,
        "property": "text",
        "value": "Done"
      },
      {
        "type": "CREATE_NODE",
        "node_id": 5,
        "node_type": "Toggle",
        "parent_id": 2,
        "child_index": null,
        "properties": {
          "value": true,
          "label": "Auto-sync"
        }
      },
      {
        "type": "REORDER_CHILDREN",
        "parent_id": 2,
        "new_order": [5, 4, 3]
      }
    ]
  },
  "expected_outcome": {
    "status": "success",
    "committed_revision": 3,
    "store_state": {
      "node_count": 5,
      "roots": [1],
      "nodes": {
        "1": {
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "ordered_children": [2],
          "properties": {
            "label": "Sequential Demo"
          }
        },
        "2": {
          "node_id": 2,
          "node_type": "Column",
          "parent_id": 1,
          "ordered_children": [5, 4, 3],
          "properties": {}
        },
        "3": {
          "node_id": 3,
          "node_type": "Button",
          "parent_id": 2,
          "ordered_children": [],
          "properties": {
            "label": "Submitted",
            "enabled": false
          }
        },
        "4": {
          "node_id": 4,
          "node_type": "Text",
          "parent_id": 2,
          "ordered_children": [],
          "properties": {
            "text": "Done"
          }
        },
        "5": {
          "node_id": 5,
          "node_type": "Toggle",
          "parent_id": 2,
          "ordered_children": [],
          "properties": {
            "label": "Auto-sync",
            "value": true
          }
        }
      },
      "model_count": 0,
      "models": {}
    }
  }
}
