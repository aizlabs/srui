{
  "name": "move_node_cycle_prevention",
  "description": "Attempting to move an ancestor node under one of its own descendants is rejected with cycle_detected (§13).",
  "spec_sections": ["§13"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {}
        },
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Column",
          "parent_id": 1,
          "child_index": null,
          "properties": {}
        },
        {
          "type": "CREATE_NODE",
          "node_id": 3,
          "node_type": "Row",
          "parent_id": 2,
          "child_index": null,
          "properties": {}
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "MOVE_NODE",
        "node_id": 1,
        "new_parent_id": 3,
        "new_child_index": null
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "cycle_detected",
    "failed_op_index": 0,
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
