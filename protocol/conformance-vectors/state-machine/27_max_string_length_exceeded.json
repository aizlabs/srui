{
  "name": "max_string_length_exceeded",
  "description": "Setting a string property one byte over max_string_length is rejected with max_string_length_exceeded (§26).",
  "spec_sections": ["§26"],
  "initial_limits": {
    "max_string_length": 10
  },
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Short"
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 1,
        "property": "label",
        "value": "01234567890"
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "max_string_length_exceeded",
    "failed_op_index": 0,
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
