{
  "name": "max_value_depth_exceeded",
  "description": "Setting a nested list value one level over max_value_depth is rejected with max_value_depth_exceeded (§26).",
  "spec_sections": ["§26"],
  "initial_limits": {
    "max_value_depth": 3
  },
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {}
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 1,
        "property": "value",
        "value": [[[42]]]
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "max_value_depth_exceeded",
    "failed_op_index": 0,
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
