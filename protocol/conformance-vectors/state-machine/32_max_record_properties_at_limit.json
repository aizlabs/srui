{
  "name": "max_record_properties_at_limit",
  "description": "Setting a small record with exactly max_record_properties entries succeeds (§26).",
  "spec_sections": ["§26"],
  "initial_limits": {
    "max_record_properties": 2
  },
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {}
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 1,
        "property": "value",
        "value": {
          "record_type": "Surface",
          "properties": {
            "label": "A",
            "accessible_description": "B"
          }
        }
      }
    ]
  },
  "expected_outcome": {
    "status": "success",
    "committed_revision": 2,
    "store_state": {
      "node_count": 1,
      "roots": [1],
      "nodes": {
        "1": {
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "ordered_children": [],
          "properties": {
            "value": {
              "record_type": "Surface",
              "properties": {
                "label": "A",
                "accessible_description": "B"
              }
            }
          }
        }
      },
      "model_count": 0,
      "models": {}
    }
  }
}
