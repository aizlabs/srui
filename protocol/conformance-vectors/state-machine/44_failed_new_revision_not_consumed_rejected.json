  "spec_sections": ["§12.1", "§13"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Retry Baseline"
          }
        },
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Button",
          "parent_id": 1,
          "child_index": null,
          "properties": {
            "label": "Click Me",
            "enabled": true
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 99,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 2,
        "property": "label",
        "value": "Would Commit"
      },
      {
        "type": "CREATE_NODE",
        "node_id": 3,
        "node_type": "Text",
