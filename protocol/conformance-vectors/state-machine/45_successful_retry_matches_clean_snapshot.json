{
  "name": "successful_retry_matches_clean_snapshot",
  "description": "After a failed transaction is rolled back, a corrected retry at base_revision + 1 produces the same store state as a clean apply from the pre-failure snapshot (§12.1, §13).",
  "spec_sections": ["§12.1", "§13"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Retry Baseline"
          }
        },
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Button",
          "parent_id": 1,
          "child_index": null,
          "properties": {
            "label": "Click Me",
            "enabled": true
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 2,
        "property": "label",
        "value": "Retried OK"
      },
      {
        "type": "CREATE_NODE",
        "node_id": 3,
        "node_type": "Text",
        "parent_id": 2,
        "child_index": null,
        "properties": {
          "text": "Clean Snapshot Match"
        }
      }
    ]
  },
  "expected_outcome": {
    "status": "success",
    "committed_revision": 2,
    "store_state": {
      "node_count": 3,
      "roots": [1],
      "nodes": {
        "1": {
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "ordered_children": [2],
          "properties": {
            "label": "Retry Baseline"
          }
        },
        "2": {
          "node_id": 2,
          "node_type": "Button",
          "parent_id": 1,
          "ordered_children": [3],
          "properties": {
            "label": "Retried OK",
            "enabled": true
          }
        },
        "3": {
          "node_id": 3,
          "node_type": "Text",
          "parent_id": 2,
          "ordered_children": [],
          "properties": {
            "text": "Clean Snapshot Match"
          }
        }
      },
      "model_count": 0,
      "models": {}
    }
  }
}
