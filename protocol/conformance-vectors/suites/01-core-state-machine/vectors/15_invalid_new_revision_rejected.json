{
  "name": "invalid_new_revision_rejected",
  "description": "A transaction specifying new_revision != base_revision + 1 is rejected with invalid_new_revision (§12.1).",
  "spec_sections": ["§12.1"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Window 1"
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 99,
    "operations": [
      {
        "type": "CREATE_NODE",
        "node_id": 2,
        "node_type": "Button",
        "parent_id": 1,
        "child_index": null,
        "properties": {
          "label": "Bad Revision"
        }
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "invalid_new_revision",
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
