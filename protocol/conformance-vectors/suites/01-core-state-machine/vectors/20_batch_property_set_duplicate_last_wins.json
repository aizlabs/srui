{
  "name": "batch_property_set_duplicate_last_wins",
  "description": "When BATCH_PROPERTY_SET lists the same property more than once, later entries win; the semantic result matches sequential SET_PROPERTY calls (§13 BATCH_PROPERTY_SET).",
  "spec_sections": ["§13", "§12.1"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Duplicate Batch Demo"
          }
        },
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Button",
          "parent_id": 1,
          "child_index": null,
          "properties": {
            "label": "Initial Label",
            "enabled": true
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "BATCH_PROPERTY_SET",
        "node_id": 2,
        "properties": [
          { "property": "label", "value": "First Label" },
          { "property": { "local_id": 1 }, "value": "Final Label" },
          { "property": "enabled", "value": false }
        ]
      }
    ]
  },
  "expected_outcome": {
    "status": "success",
    "committed_revision": 2,
    "store_state": {
      "node_count": 2,
      "roots": [1],
      "nodes": {
        "1": {
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "ordered_children": [2],
          "properties": {
            "label": "Duplicate Batch Demo"
          }
        },
        "2": {
          "node_id": 2,
          "node_type": "Button",
          "parent_id": 1,
          "ordered_children": [],
          "properties": {
            "label": "Final Label",
            "enabled": false
          }
        }
      },
      "model_count": 0,
      "models": {}
    }
  }
}
