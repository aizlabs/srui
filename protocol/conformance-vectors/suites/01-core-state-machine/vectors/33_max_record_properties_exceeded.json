{
  "name": "max_record_properties_exceeded",
  "description": "Setting a small record with max_record_properties + 1 entries is rejected with max_record_properties_exceeded (§26).",
  "spec_sections": ["§26"],
  "initial_limits": {
    "max_record_properties": 2
  },
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {}
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 1,
        "property": "value",
        "value": {
          "record_type": "Surface",
          "properties": {
            "label": "A",
            "accessible_description": "B",
            "value_description": "C"
          }
        }
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "max_record_properties_exceeded",
    "failed_op_index": 0,
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
