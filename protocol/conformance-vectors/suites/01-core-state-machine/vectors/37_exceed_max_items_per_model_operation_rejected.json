{
  "name": "exceed_max_items_per_model_operation_rejected",
  "description": "A model operation batch exceeding max_items_per_model_operation is rejected with max_items_per_model_operation_exceeded and rolled back (§8, §26).",
  "spec_sections": ["§8", "§12.1", "§26"],
  "initial_limits": {
    "max_items_per_model_operation": 2
  },
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_MODEL",
          "model_id": 10,
          "model_type": "List",
          "item_count": 100
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "MODEL_INSERT",
        "model_id": 10,
        "index": 0,
        "items": [
          {
            "item_id": 1,
            "value": "one",
            "properties": {}
          },
          {
            "item_id": 2,
            "value": "two",
            "properties": {}
          },
          {
            "item_id": 3,
            "value": "three",
            "properties": {}
          }
        ]
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "max_items_per_model_operation_exceeded",
    "failed_op_index": 0,
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
