{
  "name": "coalesced_scalar_delta_delivered",
  "description": "A replica applying a live-stream frame accepts a coalesced scalar delta spanning several committed revisions (base 1 -> new 5) when every operation is a scalar SET_PROPERTY, advancing to new_revision as if each spanned transaction had been applied individually (§12.1 delivery forms, §20.4).",
  "spec_sections": ["§12.1", "§20.4"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "v0"
          }
        }
      ]
    }
  ],
  "applier": "delivered",
  "transaction": {
    "base_revision": 1,
    "new_revision": 5,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 1,
        "property": "label",
        "value": "v4"
      }
    ]
  },
  "expected_outcome": {
    "status": "success",
    "committed_revision": 5,
    "store_state": {
      "node_count": 1,
      "roots": [1],
      "nodes": {
        "1": {
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "ordered_children": [],
          "properties": {
            "label": "v4"
          }
        }
      },
      "model_count": 0,
      "models": {}
    }
  }
}
