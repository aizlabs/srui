{
  "name": "coalesced_scalar_delta_rejected_as_commit",
  "description": "The same scalar span a replica accepts as a delivery delta is rejected on the authoritative path, which advances exactly one revision. A delivery-derived span must never advance authoritative state or enter the journal (§12.1 delivery forms, §18.1, §20.4).",
  "spec_sections": ["§12.1", "§18.1", "§20.4"],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "v0"
          }
        }
      ]
    }
  ],
  "applier": "authoritative",
  "transaction": {
    "base_revision": 1,
    "new_revision": 5,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 1,
        "property": "label",
        "value": "v4"
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "invalid_new_revision",
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
