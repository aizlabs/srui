{
  "name": "shortcut_refused_on_unadmitted_type_rejected",
  "description": "A shortcut on a node type that admits none (Text) is refused with shortcut_not_admitted; the preceding label change is discarded with it (§4 inv. 13, §7.4, §12.1).",
  "spec_sections": [
    "§4",
    "§7.4",
    "§7.6",
    "§7.7",
    "§12.1",
    "§22.5",
    "§26"
  ],
  "initial_revision": 0,
  "setup_transactions": [
    {
      "base_revision": 0,
      "new_revision": 1,
      "operations": [
        {
          "type": "CREATE_NODE",
          "node_id": 1,
          "node_type": "Surface",
          "parent_id": null,
          "child_index": null,
          "properties": {
            "label": "Shortcuts"
          }
        },
        {
          "type": "CREATE_NODE",
          "node_id": 2,
          "node_type": "Text",
          "parent_id": 1,
          "child_index": null,
          "properties": {
            "text": "Status"
          }
        }
      ]
    }
  ],
  "transaction": {
    "base_revision": 1,
    "new_revision": 2,
    "operations": [
      {
        "type": "SET_PROPERTY",
        "node_id": 1,
        "property": "label",
        "value": "Renamed"
      },
      {
        "type": "SET_PROPERTY",
        "node_id": 2,
        "property": "shortcut",
        "value": "primary+r"
      }
    ]
  },
  "expected_outcome": {
    "status": "rejected",
    "error_code": "shortcut_not_admitted",
    "failed_op_index": 1,
    "expected_store_revision": 1,
    "rollback_verified": true
  }
}
