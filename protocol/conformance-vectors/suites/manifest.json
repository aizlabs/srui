      "gaps": [
        {
          "scenario": "Server event validation accepts POINTER_* events targeting ordinary Standard Widget nodes; the §32.5 rule that coordinates are refused outside a subscribed scene is unenforced.",
          "reason": "Event::validate (server-rust/semantic-tree/src/event.rs) checks observed revision, node existence, enabled/read-only state and TEXT_EDIT edit_seq, but never the event kind against the target node type. A POINTER_DOWN aimed at a Button validates successfully.",
          "future_task": "Task 36 (VectorScene profile) — the rule needs the subscription model to state what coordinates are legal for",
          "gap_probe": {
            "file": "server-rust/semantic-tree/src/event.rs",
            "absent_pattern": "CoordinateEvent|coordinate event .*(subscrib|scene)|NodeNotSubscribed",
            "explanation": "Matches once event validation gains a coordinate-vs-node-type rule. A match means suite 5 must assert the rejection instead of documenting its absence."
          }
        },
        {
          "scenario": "The positive half of §32.5 — a coordinate event ACCEPTED for an explicitly subscribed custom scene node — cannot be exercised.",
          "reason": "POINTER_* events are registered in namespace 0, but no VectorScene node type or subscription model exists on this base.",
          "future_task": "Task 36 (VectorScene profile, optional)",
          "gap_probe": {
            "file": "protocol/registry.yaml",
            "absent_pattern": "name: VectorScene",
            "explanation": "Matches once a subscribed scene node type is registered."
          }
        }
      ]
