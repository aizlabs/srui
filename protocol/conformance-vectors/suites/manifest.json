        {
          "scenario": "Event validation performs no event-type/node-type compatibility check: POINTER_* is accepted against an ordinary Button, and ACTIVATE is accepted against non-interactive Text/Progress/Image/Separator nodes.",
          "reason": "Event::validate (server-rust/semantic-tree/src/event.rs) checks observed revision, node existence and enabled state, but never compares the event type against the target node type. §32.5's rule that coordinates are refused outside a subscribed scene, and §7.6's per-node event sets, are therefore unenforced. Both are pinned by #[should_panic] tests in conformance_semantic_input_test.rs rather than papered over.",
          "future_task": "Task 36 (VectorScene) for the coordinate half; the event-type/node-type check is unowned",
          "gap_probe": {
            "file": "server-rust/semantic-tree/src/event.rs",
            "absent_pattern": "CoordinateEvent|coordinate event .*(subscrib|scene)|NodeNotSubscribed",
            "explanation": "Matches once event validation gains a coordinate-vs-node-type rule. A match means suite 5 must assert the rejection instead of documenting its absence."
          }
        }
      ]
