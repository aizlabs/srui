#!/usr/bin/env python3
"""
SRUI conformance suite runner (§32).

Runs the twelve §32 conformance suites declared in
protocol/conformance-vectors/suites/manifest.json against the Rust and Swift implementations and
prints a pass/fail/gap table.

    scripts/run-conformance                      # every suite, both implementations
    scripts/run-conformance --suite 8            # one suite by id
    scripts/run-conformance --suite reconnect    # one suite by slug
    scripts/run-conformance --implementation rust    # Linux-viable subset
    scripts/run-conformance --implementation swift

Exit status:

    0  every executable suite passed, and what remains is only declared gaps or documented
       platform exclusions
    1  a suite failed, a selected implementation had no runner and no documented reason, the
       manifest was malformed, or a declared gap turned out to be closed (which requires a
       manifest update, not a silent pass)

Results: PASS (all runners green, no open gaps), GAP (runners green but §32 scenarios remain
unproven), FAIL, and N/A (the manifest documents why this implementation has no half).

Commands come from the manifest as argument arrays and are executed without a shell, so nothing
in the manifest is shell-evaluated.

A full Rust+Swift run requires macOS: RendererAppKit cannot build on Linux. `--implementation
rust` is the Linux CI mode.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
MANIFEST_PATH = REPO_ROOT / "protocol/conformance-vectors/suites/manifest.json"
EXPECTED_SUITE_COUNT = 12

PASS, FAIL, GAP, NA = "PASS", "FAIL", "GAP", "N/A"


class ManifestError(Exception):
    """The manifest is malformed; conformance cannot be evaluated."""


def load_manifest() -> dict:
    if not MANIFEST_PATH.exists():
        raise ManifestError(f"conformance manifest not found: {MANIFEST_PATH}")
    try:
        manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise ManifestError(f"conformance manifest is not valid JSON: {exc}") from exc

    suites = manifest.get("suites")
    if not isinstance(suites, list):
        raise ManifestError("manifest 'suites' must be a list")
    if len(suites) != EXPECTED_SUITE_COUNT:
        raise ManifestError(
            f"§32 defines exactly {EXPECTED_SUITE_COUNT} suites, manifest declares {len(suites)}"
        )

    ids = [s.get("id") for s in suites]
    if sorted(ids) != list(range(1, EXPECTED_SUITE_COUNT + 1)):
        raise ManifestError(f"suite ids must be exactly 1..{EXPECTED_SUITE_COUNT}, got {ids}")
    slugs = [s.get("slug") for s in suites]
    if len(set(slugs)) != len(slugs):
        raise ManifestError(f"suite slugs must be unique, got {slugs}")

    for suite in suites:
        status = suite.get("status")
        if status not in {"active", "known_gap"}:
            raise ManifestError(f"suite {suite.get('id')} has invalid status {status!r}")
        for gap in suite.get("gaps", []):
            missing = {"scenario", "reason", "future_task", "gap_probe", "languages"} - set(gap)
            if missing:
                raise ManifestError(
                    f"suite {suite.get('id')} has a gap missing {sorted(missing)}; every gap must "
                    "be documented with a reason, an owning task, the languages it blocks, and a "
                    "probe that detects its closure — otherwise the gap can be silently fixed and "
                    "still print GAP"
                )
            unknown = set(gap["languages"]) - {"rust", "swift"}
            if unknown or not gap["languages"]:
                raise ManifestError(
                    f"suite {suite.get('id')} has a gap with invalid 'languages' "
                    f"{gap['languages']!r}; it must name at least one of rust/swift so a run that "
                    "selects neither is not told about a gap it cannot exercise"
                )
            probe = gap["gap_probe"]
            if not {"file", "absent_pattern"} <= set(probe):
                raise ManifestError(
                    f"suite {suite.get('id')} has a gap_probe missing 'file' or 'absent_pattern'"
                )
            if not (REPO_ROOT / probe["file"]).exists():
                raise ManifestError(
                    f"suite {suite.get('id')} gap_probe targets {probe['file']}, which does not "
                    "exist; a probe that can never match cannot detect closure"
                )
        if status == "known_gap" and not suite.get("gaps"):
            raise ManifestError(
                f"suite {suite.get('id')} is marked known_gap but documents no gap"
            )
        # Declared vector directories must exist, or the suite is silently absent.
        vectors = suite.get("vectors")
        if vectors:
            directory = REPO_ROOT / "protocol/conformance-vectors" / vectors["dir"]
            if not directory.is_dir():
                raise ManifestError(
                    f"suite {suite.get('id')} declares vector dir {vectors['dir']} which does not exist"
                )
            for generated in vectors.get("generated", []):
                if not (directory / generated).is_file():
                    raise ManifestError(
                        f"suite {suite.get('id')} declares generated fixture {generated} "
                        "which does not exist; run ./protocol/generate_proto.sh"
                    )

    return manifest


def check_gap_probes(suite: dict) -> list[str]:
    """Returns descriptions of gaps that appear to have been closed.

    A gap that quietly starts passing is as much a manifest bug as one that regresses: suite 11
    would otherwise stay labelled GAP forever after Task 35 lands. Probes are negative — a match
    means the missing capability now exists.
    """
    closed = []
    for gap in suite.get("gaps", []):
        probe = gap.get("gap_probe")
        if not probe:
            continue
        target = REPO_ROOT / probe["file"]
        if not target.exists():
            continue
        if re.search(probe["absent_pattern"], target.read_text(encoding="utf-8")):
            closed.append(
                f"{gap['scenario']} — {probe.get('explanation', 'gap probe matched')}"
            )
    return closed


def run_command(command: list[str], timeout: int) -> tuple[bool, str]:
    """Runs one suite command under a watchdog.

    A hung runner is a failure, not a reason to wait forever. AppKit tests can block on the
    window server (real drawing in an unattended process pins at 0% CPU and never returns), and a
    socket integration test can wait on a peer that never arrives. Without a bound, one of those
    stalls the whole conformance run — and in CI, the job's own limit is the only thing that ends
    it, with no indication of which suite was responsible.
    """
    # `start_new_session` puts the runner in its own process group. Killing only the `cargo` or
    # `swift` parent on timeout would leave the test binary and every fixture server it spawned
    # alive, holding ports and sockets while later suites run — which defeats the watchdog. A
    # process keeps its group when it is orphaned, so the group kills the whole tree.
    try:
        process = subprocess.Popen(  # noqa: S603 - commands come from the checked-in manifest
            command,
            cwd=REPO_ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
    except FileNotFoundError:
        return False, f"runner not found: {command[0]}"

    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(process.pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            process.kill()
        stdout, stderr = process.communicate()
        tail = ((stdout or "") + (stderr or "")).strip().splitlines()[-15:]
        return False, (
            f"TIMED OUT after {timeout}s; the runner's whole process group was killed. A runner "
            "that does not finish is a failure: check for a test blocking on AppKit drawing, a "
            "socket peer, or a lock.\n" + "\n".join(tail)
        )

    completed = subprocess.CompletedProcess(command, process.returncode, stdout, stderr)
    if completed.returncode != 0:
        tail = (completed.stdout + completed.stderr).strip().splitlines()
        return False, "\n".join(tail[-25:]) if tail else "command failed with no output"

    # `swift test --filter` takes a regular expression and exits 0 when it matches nothing,
    # printing only a warning. Without this check, renaming or deleting a Swift test class listed
    # in the manifest turns its suite green while exercising none of the coverage it claims —
    # exactly the false-positive class this runner exists to eliminate.
    output = completed.stdout + completed.stderr
    if "No matching test cases were run" in output:
        return False, (
            "the runner exited 0 but executed no tests: SwiftPM reported 'No matching test cases \
 were run'. A manifest filter no longer matches any test, so this suite was claiming coverage \
 it never ran. Update the filter in "
            "protocol/conformance-vectors/suites/manifest.json to the current test name."
        )
    return True, ""


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run the twelve SRUI §32 conformance suites.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--suite", help="suite id (1-12) or slug; default: all")
    parser.add_argument(
        "--implementation",
        choices=["rust", "swift", "both"],
        default="both",
        help="which implementation(s) to run; default: both",
    )
    parser.add_argument(
        "--list", action="store_true", help="list the suites and exit without running anything"
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=300,
        help=(
            "per-command watchdog in seconds (default: 300). Actual test execution here takes "
            "seconds; the rest is build time. A runner that exceeds this is killed and reported "
            "as FAIL rather than hanging the run."
        ),
    )
    args = parser.parse_args()

    try:
        manifest = load_manifest()
    except ManifestError as exc:
        print(f"conformance manifest error: {exc}", file=sys.stderr)
        return 1

    suites = sorted(manifest["suites"], key=lambda s: s["id"])

    if args.list:
        for suite in suites:
            print(f"{suite['id']:>2}  {suite['slug']:<24} {suite['status']:<10} {suite['name']}")
        return 0

    if args.suite:
        selector = args.suite.strip()
        selected = [
            s for s in suites if str(s["id"]) == selector or s["slug"] == selector
        ]
        if not selected:
            print(
                f"no suite matches {selector!r}; run --list to see the twelve suites",
                file=sys.stderr,
            )
            return 1
        suites = selected

    languages = ["rust", "swift"] if args.implementation == "both" else [args.implementation]

    results: list[tuple[int, str, str, str]] = []
    failures: list[str] = []
    exit_code = 0

    for suite in suites:
        # A closed gap is a manifest bug, whatever the suite's commands do.
        for closed in check_gap_probes(suite):
            failures.append(f"suite {suite['id']} ({suite['slug']}): gap appears closed — {closed}")
            exit_code = 1

        not_applicable = suite.get("not_applicable", {})

        # Every selected language must be accounted for *per language*. Flattening the languages
        # into one command list would let one implementation hide the other's absence: a suite
        # with only a Swift runner would report PASS under `--implementation both` even though
        # nothing on the Rust side was ever executed.
        missing_languages = [
            lang
            for lang in languages
            if not suite.get(lang) and lang not in not_applicable
        ]
        for lang in missing_languages:
            failures.append(
                f"suite {suite['id']} ({suite['slug']}): no {lang} runner declared, and the "
                f"manifest does not record {lang} as not applicable. Every §32 suite must be "
                "runnable or explicitly account for why it is not."
            )
            exit_code = 1

        commands = [(lang, cmd) for lang in languages for cmd in suite.get(lang, [])]
        # Languages the manifest explicitly excuses, so the table can say so rather than imply
        # coverage that does not exist.
        excused = [lang for lang in languages if lang in not_applicable]

        # No fail-fast: every suite reports, so one failure does not hide the rest.
        suite_status = PASS
        failed_languages: list[str] = []
        for lang, command in commands:
            ok, detail = run_command(command, args.timeout)
            if not ok:
                suite_status = FAIL
                exit_code = 1
                failed_languages.append(lang)
                failures.append(
                    f"suite {suite['id']} ({suite['slug']}) [{lang}]: {' '.join(command)}\n{detail}"
                )

        if missing_languages:
            suite_status = FAIL

        gaps = suite.get("gaps", [])
        if suite_status == FAIL:
            reasons = sorted(set(failed_languages))
            note = f"{len(commands)} runner(s)"
            if reasons:
                note += "; failed: " + ", ".join(reasons)
            if missing_languages:
                note += (
                    f"; undeclared missing runner: "
                    f"{', '.join(missing_languages)}"
                )
        elif not commands:
            # A gap only concerns a run that selected the language it blocks. Suite 11's gap is a
            # Swift-side client API, so `--implementation rust` is a documented platform exclusion
            # (N/A with the manifest's reason), while a Swift or combined run must still report
            # GAP rather than quietly excusing the missing work.
            if gaps and any(set(gap["languages"]) & set(languages) for gap in gaps):
                suite_status = GAP
            elif bool(languages) and all(lang in not_applicable for lang in languages):
                suite_status = NA
            else:
                suite_status = GAP if suite["status"] == "known_gap" else NA
            if gaps and suite_status == GAP:
                note = f"no runnable coverage; awaiting {gaps[0]['future_task']}"
            else:
                # `N/A` is a documented platform exclusion, never a silently skipped suite: the
                # manifest must say why, and that reason is printed here.
                reasons = "; ".join(
                    not_applicable[lang] for lang in languages if lang in not_applicable
                )
                note = reasons or "no runnable coverage for " + "/".join(languages)
        elif gaps:
            # Runners pass, but the suite documents scenarios §32 requires and this base cannot
            # exercise. Reporting PASS here would overstate coverage, which is exactly what the
            # pass-or-known-gap acceptance criterion exists to prevent.
            suite_status = GAP
            note = f"{len(commands)} runner(s) pass; {len(gaps)} open gap: {gaps[0]['future_task']}"
            if len(gaps) > 1:
                note += f" (+{len(gaps) - 1} more)"
        else:
            note = f"{len(commands)} runner(s)"
            if excused:
                note += f"; {'/'.join(excused)} n/a"
        results.append((suite["id"], suite["slug"], suite_status, note))

    print()
    print(f"SRUI §32 conformance — {args.implementation}")
    print("=" * 78)
    print(f"{'#':>2}  {'suite':<24} {'result':<7} notes")
    print("-" * 78)
    for suite_id, slug, status, note in results:
        print(f"{suite_id:>2}  {slug:<24} {status:<7} {note}")
    print("=" * 78)

    counts = {status: sum(1 for r in results if r[2] == status) for status in (PASS, FAIL, GAP, NA)}
    print(
        f"{counts[PASS]} passed, {counts[FAIL]} failed, "
        f"{counts[GAP]} documented gap(s), {counts[NA]} not applicable"
    )

    if failures:
        print()
        print("Failures")
        print("-" * 78)
        for failure in failures:
            print(failure)
            print()

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
